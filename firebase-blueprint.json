{
  "entities": {
    "Product": {
      "title": "Producto",
      "description": "Un producto del inventario",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "stock": { "type": "number" },
        "price": { "type": "number" }
      },
      "required": ["id", "name", "price"]
    },
    "Movement": {
      "title": "Movimiento",
      "description": "Un registro de ingreso o gasto (incluye ventas)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["ingreso", "gasto"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "items": { "type": "array" },
        "customerId": { "type": "string" }
      },
      "required": ["id", "type", "amount", "date", "description"]
    },
    "Customer": {
      "title": "Cliente",
      "description": "Datos de un cliente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "acceptedReceipt": { "type": "boolean" },
        "acceptedPromotions": { "type": "boolean" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone"]
    }
  },
  "firestore": {
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Productos del usuario"
    },
    "/users/{userId}/movements/{movementId}": {
      "schema": "Movement",
      "description": "Movimientos financieros y ventas del usuario"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Base de datos de clientes del usuario"
    }
  }
}
