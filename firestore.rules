rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products Rules
    match /users/{userId}/products/{productId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProduct(request.resource.data);
      allow update: if isOwner(userId) && isValidProduct(request.resource.data);
      allow delete: if isOwner(userId);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'stock', 'price']) 
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() <= 100
        && data.stock is number
        && data.price is number;
    }

    // Movements Rules
    match /users/{userId}/movements/{movementId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidMovement(request.resource.data);
      allow update: if isOwner(userId) && isValidMovement(request.resource.data);
      allow delete: if isOwner(userId);
    }

    function isValidMovement(data) {
      return data.keys().hasAll(['id', 'type', 'amount', 'date', 'description'])
        && data.id is string && data.id.size() <= 64
        && data.type in ['ingreso', 'gasto']
        && data.amount is number
        && data.date is string
        && data.description is string && data.description.size() <= 200;
    }

    // Customers Rules
    match /users/{userId}/customers/{customerId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidCustomer(request.resource.data);
      allow update: if isOwner(userId) && isValidCustomer(request.resource.data);
      allow delete: if isOwner(userId);
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'name', 'phone'])
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20;
    }
  }
}
